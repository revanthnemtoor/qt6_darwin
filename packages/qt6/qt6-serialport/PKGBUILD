# Maintainer: Revanth <revanth@darwin>
pkgname=qt6-serialport
pkgver=6.12.0
_qtver=${pkgver%.*}
pkgrel=1
pkgdesc="Provides access to hardware and virtual serial ports (IOKit backend on Darwin)"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://www.qt.io"
license=('GPL3' 'LGPL3' 'FDL' 'custom')
depends=('qt6-base')
makedepends=('cmake' 'ninja')
_pkgfqn="qtserialport-everywhere-src-${pkgver}"
source=("https://download.qt.io/official_releases/qt/${_qtver}/${pkgver}/submodules/${_pkgfqn}.tar.xz")
sha256sums=('ba8886a54eee466e57c9fa1341255cc09c462c84baab3ee7b19d67cdbcbd71c3')

build() {
    local _arch="${CARCH:-darwin_x86_64}"
    local _osx_arch="x86_64"
    if [[ "$_arch" == "darwin_arm64" || "$_arch" == "arm64" || "$_arch" == "aarch64" ]]; then
        _osx_arch="arm64"
    fi

    cmake -B build -S "${_pkgfqn}" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/pacman \
        -DCMAKE_PREFIX_PATH=/opt/pacman \
        -DCMAKE_IGNORE_PREFIX_PATH="/opt/local;/usr/local" \
        -DCMAKE_OSX_ARCHITECTURES="${_osx_arch}" \
        -DCMAKE_OSX_DEPLOYMENT_TARGET="15.0" \
        -DCMAKE_INSTALL_RPATH="/opt/pacman/lib" \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DQT_FEATURE_framework=OFF \
        -DQT_BUILD_TESTS=OFF \
        -DQT_BUILD_EXAMPLES=OFF

    cmake --build build --parallel "$(sysctl -n hw.ncpu)"
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    find "${pkgdir}" -name ".DS_Store" -delete 2>/dev/null || true
    find "${pkgdir}" -name "*.prl" -exec sed -i '' -e '/^QMAKE_PRL_BUILD_DIR/d' {} + 2>/dev/null || true
    if [[ "$(uname -s)" == "Darwin" ]]; then
        find "${pkgdir}/opt/pacman" -type f | while read -r f; do
            if file "$f" | grep -qE "Mach-O.*(executable|dynamically linked shared library|bundle)"; then
                codesign --sign - --force "$f" 2>/dev/null || true
            fi
        done
    fi
    install -d "${pkgdir}/opt/pacman/share/licenses/${pkgname}"
    cp -a "${srcdir}/${_pkgfqn}/LICENSES/"* "${pkgdir}/opt/pacman/share/licenses/${pkgname}/" 2>/dev/null || true
}

